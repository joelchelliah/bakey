{
  "name": "bakey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
